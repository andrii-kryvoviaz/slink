{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "types": ["node", "$app/types"],
    "strict": true,
    "target": "ES2022",
    "module": "ESNext"
  },
  "exclude": ["node_modules/**", "src/locales/**", "src/service-worker.ts"],
  "include": ["src", "vite.config.ts"]
}
