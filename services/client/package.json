{
  "name": "slink-client",
  "version": "1.13.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:with-deps": "yarn install --immutable && yarn dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest run",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "prepare": "cd ../.. && husky ./services/client/.husky",
    "i18n": "wuchale --clean",
    "i18n:extract": "wuchale",
    "i18n:compile": "wuchale",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@iconify/svelte": "5.2.2",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "9.2.4",
    "@tanstack/table-core": "9.2.4",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.10.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@wuchale/svelte": "0.21.4",
    "apexcharts": "7.6.0",
    "bits-ui": "^2.19.3",
    "class-variance-authority": "^0.7.1",
    "crawler-user-agents": "^1.60.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "redis": "6.2.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1",
    "wuchale": "0.26.7"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "svelte-kit sync",
      "svelte-check --tsconfig ./tsconfig.json",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "resolutions": {
    "picomatch": ">=4.0.4",
    "minimatch": ">=10.0.0",
    "serialize-javascript": ">=7.0.0",
    "cookie": "^0.7.2"
  }
}
