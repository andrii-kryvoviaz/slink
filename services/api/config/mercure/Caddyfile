{
	http_port 3333
	https_port 0
	auto_https off

	log {
		output stdout
		format console
		level INFO
	}
}

:3333 {
	route {
		mercure {
			resource_identifier https://mercure.slink.example
			issuer slink {
				publisher {
					jwt {env.MERCURE_JWT_SECRET} HS256
				}
				subscriber {
					jwt {env.MERCURE_JWT_SECRET} HS256
				}
			}
			anonymous
			cors_origins *
			publish_origins *
			subscriptions
		}
		respond "Mercure Hub"
	}
}
