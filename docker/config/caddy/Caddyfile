{
	admin off
	auto_https off
	persist_config off
	storage file_system /data/caddy
	log {
		level ERROR
	}
	servers {
		protocols h1 h2c
	}
	frankenphp {
		worker {
			file /services/api/public/index.php
		}
	}
}

:8080 {
	mercure {
		transport bolt {
			path /data/caddy/mercure.db
		}
		resource_identifier https://mercure.slink.example
		issuer slink {
			publisher {
				jwt {env.MERCURE_JWT_SECRET} HS256
			}
			subscriber {
				jwt {env.MERCURE_JWT_SECRET} HS256
			}
		}
		anonymous
		cors_origins *
		publish_origins *
		subscriptions
	}

	root * /services/api/public
	php_server
}
