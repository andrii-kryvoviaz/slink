{
	admin off
	auto_https off
	persist_config off
	storage file_system /data/caddy
	log {
		level ERROR
	}
}

:3333 {
	route {
		mercure {
			transport bolt {
				path /data/caddy/mercure.db
			}
			resource_identifier https://mercure.slink.example
			issuer slink {
				publisher {
					jwt {env.MERCURE_JWT_SECRET} HS256
				}
				subscriber {
					jwt {env.MERCURE_JWT_SECRET} HS256
				}
			}
			anonymous
			cors_origins *
			publish_origins *
			subscriptions
		}
		respond "Mercure Hub"
	}
}
